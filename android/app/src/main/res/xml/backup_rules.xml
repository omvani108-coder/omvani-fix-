<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy backup rules for Android 11 and below.
    Exclude all app data from adb backup / cloud backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
