# OmVani — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

VITE_SUPABASE_URL=https://tdinnhkdrebwmihazaqf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key_from_supabase_dashboard
VITE_SUPABASE_PROJECT_ID=tdinnhkdrebwmihazaqf
VITE_SENTRY_DSN=               # Sentry DSN for frontend error monitoring (optional — omit to disable)
VITE_POSTHOG_KEY=              # PostHog project API key (optional — omit to disable analytics)

# ─────────────────────────────────────────────────────────────────
# Supabase Edge Function Secrets
# These are NOT set in .env — they live in Supabase.
# Set them via:  npx supabase secrets set KEY=value --project-ref tdinnhkdrebwmihazaqf
#
# SUPABASE_URL              — auto-set by Supabase (do not set manually)
# SUPABASE_SERVICE_ROLE_KEY — auto-set by Supabase (do not set manually)
#
# SUPABASE_ANON_KEY         — Supabase anon/public key (used by delete-account)
# ANTHROPIC_API_KEY         — Anthropic API key (chat + kundli analysis)
# GEMINI_API_KEY            — Google Gemini API key (sadhana report + deity identification)
# ELEVENLABS_API_KEY        — ElevenLabs API key (text-to-speech + speech-to-text)
# RAZORPAY_KEY_ID           — Razorpay key ID (payments)
# RAZORPAY_KEY_SECRET       — Razorpay key secret (payments)
# RAZORPAY_WEBHOOK_SECRET   — Razorpay webhook secret (subscription updates)
# RAZORPAY_PLAN_BASIC       — Razorpay plan ID for Basic plan
# RAZORPAY_PLAN_PRO         — Razorpay plan ID for Pro plan
# RAZORPAY_PLAN_FAMILY      — Razorpay plan ID for Family plan
# RESEND_API_KEY            — Resend API key (email reminders)
# TWILIO_ACCOUNT_SID        — Twilio account SID (WhatsApp reminders)
# TWILIO_AUTH_TOKEN          — Twilio auth token (WhatsApp reminders)
# TWILIO_WHATSAPP_FROM       — Twilio WhatsApp sender number (WhatsApp reminders)
# CRON_SECRET               — Secret token for cron-triggered functions (send-reminders)
# ENVIRONMENT               — Set to "development" to allow localhost CORS (omit in production)
# SENTRY_DSN                 — Sentry DSN for server-side error monitoring (edge functions)
# ─────────────────────────────────────────────────────────────────
